{
  "name": "@precedence-dev/viewer",
  "version": "0.1.5",
  "description": "A browser for Precedence's catalog.pcs - review every tracking attach point, pick nodes, export an event plan. Zero dependencies; the CLI bakes a shareable static copy.",
  "license": "FSL-1.1-ALv2",
  "author": "Precedence",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/precedence-dev/sdk.git",
    "directory": "packages/viewer"
  },
  "homepage": "https://github.com/precedence-dev/sdk/tree/main/packages/viewer",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "precedence-view": "bin/precedence-view.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "bin/",
    "browser/",
    "index.html",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "prepare": "npm run build",
    "test": "npm run build && node test/invariants.mjs"
  }
}
