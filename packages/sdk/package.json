{
  "name": "@precedence-dev/sdk",
  "version": "0.1.0",
  "description": "The runtime half of Precedence: installPrecedence, for @precedence-dev/instrument's emit: \"runtime\" mode. Framework-agnostic, zero dependencies.",
  "license": "FSL-1.1-ALv2",
  "author": "Precedence",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/precedence-dev/sdk.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/precedence-dev/sdk/tree/main/packages/sdk",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "prepare": "npm run build",
    "test": "npm run build && node test/invariants.mjs"
  }
}
